# Copy to .env.local and fill in.

# From https://cloud.reown.com (free) — needed for real WalletConnect support.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=46f26d8e63eb8c8ce9795b70dc681ade

# Fill this in after deploying the contract (see /hardhat/README.md).
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0xA071a23aC8dbDD1e679828F837Bc66E1362694f6

# The site runs on Robinhood Chain MAINNET only — there is no testnet mode.
# These override the built-in mainnet defaults in config/web3.ts if you
# ever need to point at a different RPC endpoint or chain id.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_MAINNET_CHAIN_ID=4663

# Optional — defaults to https://ipfs.io/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Free API key from https://dashboard.alchemy.com — used by the Staking
# page to look up which Mini Brokers NFTs the connected wallet owns.
NEXT_PUBLIC_ALCHEMY_API_KEY=alch_x3CZDPyK05uQPn8bnU467

NEXT_PUBLIC_BURN_LAB_CONTRACT_ADDRESS=0x427720F18f6BfaFbF7A8a4c135a4B9A98f2F803c

# ==========================================
# Exchange (SWAP) — Robinhood Chain MAINNET only
# ==========================================
# Router/aggregator contract address. Leave blank until a router is
# deployed — the Exchange page stays visible but reports swap execution
# as "not configured yet" until this is set.
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=
# ERC-20 token paired against native RH in the swap interface.
NEXT_PUBLIC_SWAP_TOKEN_ADDRESS=0x6be753538a564f72b0200af2e90DD246e2c03F3e
NEXT_PUBLIC_SWAP_TOKEN_SYMBOL=MINI
# ISO-8601 timestamp (or ms epoch) the 14-day Exchange countdown counts down to.
NEXT_PUBLIC_EXCHANGE_LAUNCH_TIMESTAMP=2026-08-25T00:00:00Z

# ==========================================
# Clock In
# ==========================================
# Contract that records/rewards a wallet's clock-in. Leave blank until
# deployed — the Clock In page stays visible but reports the action as
# "not configured yet" until this is set.
NEXT_PUBLIC_CLOCK_IN_CONTRACT_ADDRESS=0x66A96c26f522D97e2E76be3a2585b8F7EB3453Aa
# ISO-8601 timestamp (or ms epoch) the 7-day Clock In countdown counts down to.


# ==========================================
# NFT Staking
# ==========================================
# Fill this in after running `npm run deploy:staking` from the
# staking-clockin-contracts package. Leave blank until deployed — the
# Staking page stays visible but reports staking as "not configured yet".
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=0xA8b40BCaBe356591cca634B39711e37BF5856E56

NEXT_PUBLIC_SITE_URL=https://www.minibrokers.cash
SITE_URL=https://www.minibrokers.cash
